<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spacing scale, the same steps as the macOS app (2 · 4 · 8 · 12 · 16 · 24). -->
    <x:Double x:Key="SpacingXXSmall">2</x:Double>
    <x:Double x:Key="SpacingXSmall">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>

    <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="RowPadding">12,8,12,8</Thickness>
    <Thickness x:Key="InspectorPadding">16</Thickness>
    <Thickness x:Key="BannerPadding">12,10,12,10</Thickness>
    <Thickness x:Key="BadgePadding">6,1,6,1</Thickness>
    <Thickness x:Key="TitleBarPadding">12,0,0,0</Thickness>

    <!-- Windows 11 geometry: 4 px for controls, 8 px for cards and overlays. -->
    <CornerRadius x:Key="SmallRadius">4</CornerRadius>
    <CornerRadius x:Key="MediumRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">10</CornerRadius>
    <CornerRadius x:Key="ContentCornerRadius">8,0,0,0</CornerRadius>

    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="SidebarWidth">264</x:Double>
    <x:Double x:Key="InspectorWidth">300</x:Double>
    <x:Double x:Key="IconSize">16</x:Double>
    <x:Double x:Key="LargeIconSize">32</x:Double>
    <x:Double x:Key="EmptyStateIconSize">48</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">440</x:Double>
    <x:Double x:Key="SwatchSize">10</x:Double>
    <x:Double x:Key="SizeBarWidth">56</x:Double>
    <x:Double x:Key="SizeBarHeight">6</x:Double>
    <!-- The narrowest the Name column gets; the chart gives up width before the names do. -->
    <x:Double x:Key="NameColumnMinWidth">200</x:Double>
    <!-- List item padding and the scroll bar, on top of the columns. -->
    <x:Double x:Key="ListChromeWidth">48</x:Double>
    <x:Double x:Key="SizeTextMinWidth">72</x:Double>
    <!-- Developer view: the stacked safety bar, and a column wide enough for its longest action button. -->
    <x:Double x:Key="SummaryBarHeight">16</x:Double>
    <CornerRadius x:Key="SummaryBarRadius">8</CornerRadius>
    <x:Double x:Key="ActionColumnMinWidth">190</x:Double>
    <!-- What Grew and Large Files: change pills never wrap; dates and sizes line up in columns. -->
    <x:Double x:Key="GrowthColumnMinWidth">108</x:Double>
    <x:Double x:Key="DateColumnWidth">110</x:Double>
    <x:Double x:Key="GrowthBarHeight">4</x:Double>
    <x:Double x:Key="GrowthBarMinimumLength">3</x:Double>
    <x:Double x:Key="ToolbarButtonWidth">44</x:Double>
    <x:Double x:Key="SearchBoxWidth">220</x:Double>
    <x:Double x:Key="SettingsMaxWidth">640</x:Double>
    <Thickness x:Key="ToastMargin">0,0,0,24</Thickness>
    <Thickness x:Key="BannerActionsMargin">0,0,0,12</Thickness>
</ResourceDictionary>
