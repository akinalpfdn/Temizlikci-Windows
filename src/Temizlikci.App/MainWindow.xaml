<Window
    x:Class="Temizlikci.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:Temizlikci.Presentation.Strings">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarGridHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: icon, name and menu bar; the empty remainder is the drag region. -->
        <Grid x:Name="TitleBar" Padding="{StaticResource TitleBarPadding}" ColumnSpacing="{StaticResource SpacingSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEB05;" FontSize="{StaticResource IconSize}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind s:L10n.AppName}" Style="{StaticResource TitleBarTitleTextStyle}" />
            <MenuBar Grid.Column="2" x:Name="AppMenuBar" VerticalAlignment="Center">
                <MenuBarItem Title="{x:Bind s:L10n.MenuFile}">
                    <MenuFlyoutItem Text="{x:Bind s:L10n.MenuExit}" Click="OnExit" />
                </MenuBarItem>
                <MenuBarItem Title="{x:Bind s:L10n.MenuView}">
                    <ToggleMenuFlyoutItem Text="{x:Bind s:L10n.MenuShowInspector}" IsChecked="{x:Bind ViewModel.IsInspectorPresented, Mode=TwoWay}">
                        <ToggleMenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </ToggleMenuFlyoutItem.KeyboardAccelerators>
                    </ToggleMenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>
            <Border Grid.Column="3" x:Name="DragRegion" Background="Transparent" />
        </Grid>

        <NavigationView
            x:Name="Sidebar"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="{StaticResource SidebarWidth}"
            SelectionChanged="OnSidebarSelectionChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="{StaticResource InspectorGridWidth}" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ContentHost">
                    <StackPanel x:Name="LocationEmptyState" Style="{StaticResource EmptyStatePanelStyle}">
                        <FontIcon Glyph="&#xEB05;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="{x:Bind s:L10n.OverviewEmptyTitle}" Style="{StaticResource EmptyStateTitleTextStyle}" />
                        <TextBlock Text="{x:Bind s:L10n.OverviewEmptyMessage}" Style="{StaticResource EmptyStateMessageTextStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="InsightEmptyState" Style="{StaticResource EmptyStatePanelStyle}" Visibility="Collapsed">
                        <FontIcon x:Name="InsightEmptyIcon" Glyph="&#xEC7A;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="{x:Bind s:L10n.InsightsNotScannedTitle}" Style="{StaticResource EmptyStateTitleTextStyle}" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="Inspector"
                    Grid.Column="1"
                    BorderBrush="{ThemeResource ContentDividerBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{x:Bind ViewModel.IsInspectorPresented, Mode=OneWay}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}" Padding="{StaticResource InspectorPadding}">
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="{x:Bind s:L10n.InspectorNoSelectionTitle}" Style="{StaticResource EmptyStateTitleTextStyle}" />
                        <TextBlock Text="{x:Bind s:L10n.InspectorNoSelectionMessage}" Style="{StaticResource EmptyStateMessageTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
