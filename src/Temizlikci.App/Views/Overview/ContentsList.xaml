<UserControl
    x:Class="Temizlikci.App.Views.Overview.ContentsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Temizlikci.App.Views.Overview"
    xmlns:s="using:Temizlikci.Presentation.Strings">

    <Grid RowSpacing="{StaticResource SpacingXSmall}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column headers sort the list; clicking the same one again reverses the order. -->
        <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="{StaticResource SpacingSmall}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                <ColumnDefinition x:Name="ChangeHeaderColumn" Width="0" />
                <ColumnDefinition Width="{StaticResource ShareColumnWidth}" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NameHeader" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSortByName" HorizontalAlignment="Left">
                <TextBlock x:Name="NameHeaderText" Text="{x:Bind s:L10n.TableName}" />
            </Button>
            <Button x:Name="SizeHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSortBySize" HorizontalAlignment="Right">
                <TextBlock x:Name="SizeHeaderText" Text="{x:Bind s:L10n.TableSize}" />
            </Button>
            <TextBlock x:Name="ChangeHeader" Grid.Column="2" Visibility="Collapsed" Text="{x:Bind s:L10n.TableChange}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{x:Bind s:L10n.TableShare}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ListView
            x:Name="Rows"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            SelectionChanged="OnSelectionChanged"
            DoubleTapped="OnDoubleTapped"
            KeyDown="OnRowsKeyDown"
            RightTapped="OnRightTapped"
            CanDragItems="True"
            DragItemsStarting="OnDragItemsStarting">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ContentRow">
                    <Grid ColumnSpacing="{StaticResource SpacingSmall}" ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                            <ColumnDefinition Width="{x:Bind ChangeColumnWidth}" />
                            <ColumnDefinition Width="{StaticResource ShareColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}" VerticalAlignment="Center">
                            <Border Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}" CornerRadius="2" Background="{x:Bind SwatchBrush}" BorderBrush="{x:Bind SwatchBorderBrush}" BorderThickness="1.5" />
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                            <ProgressRing IsActive="{x:Bind IsMeasuring}" Visibility="{x:Bind MeasuringVisibility}" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXSmall}" Visibility="{x:Bind NeedsAccessVisibility}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="{StaticResource CaptionFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind s:L10n.NodeNeedsAccess}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXSmall}" Visibility="{x:Bind SafetyVisibility}" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind SafetyGlyph}" FontSize="{StaticResource CaptionFontSize}" Foreground="{x:Bind SafetyBrush}" />
                                <TextBlock Text="{x:Bind SafetyText}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind SafetyBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid Width="{StaticResource SizeBarWidth}" Height="{StaticResource SizeBarHeight}" VerticalAlignment="Center">
                                <Border Background="{ThemeResource SizeBarTrackBrush}" CornerRadius="3" />
                                <Border Width="{x:Bind BarLength}" Background="{x:Bind BarBrush}" CornerRadius="3" HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource SizeTextStyle}" MinWidth="{StaticResource SizeTextMinWidth}" />
                        </StackPanel>
                        <Border Grid.Column="2" Visibility="{x:Bind ChangeVisibility}" Background="{x:Bind ChangeBackground}" CornerRadius="{StaticResource PillRadius}" Padding="{StaticResource BadgePadding}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXSmall}">
                                <FontIcon Glyph="{x:Bind ChangeGlyph}" FontSize="{StaticResource CaptionFontSize}" Foreground="{x:Bind ChangeBrush}" />
                                <TextBlock Text="{x:Bind ChangeText}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind ChangeBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind ShareText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="NoResults" Grid.Row="1" Style="{StaticResource EmptyStateMessageTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
